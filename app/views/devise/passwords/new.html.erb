<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
  <div class="col-12 col-md-6 col-lg-4">
    <div class="card shadow-lg border-0">
      <div class="card-header text-center text-white" style="background-color: #1F509A;">
        <h4 class="mb-0"><%= t('devise_views.forgot_title') %></h4>
      </div>
      <div class="card-body p-4">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
          <p class="text-muted mb-4">
            <%= t('devise_views.forgot_instructions') %>
          </p>

          <% if resource.errors.any? %>
            <div class="alert alert-danger">
              <% resource.errors.full_messages.each do |message| %>
                <div><%= message %></div>
              <% end %>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :email, t('devise_views.email_label'), class: "form-label" %>
            <%= f.email_field :email, class: "form-control", placeholder: t('devise_views.email_placeholder'), autofocus: true, autocomplete: "email" %>
          </div>

          <div class="d-grid">
            <%= f.submit t('devise_views.send_instructions'), class: "btn btn-primary", style: "background-color: #1F509A; border-color: #1F509A;" %>
          </div>
        <% end %>

        <hr class="my-4">

        <div class="text-center">
          <%= link_to t('devise_views.back_to_login'), root_path, class: "text-muted" %>
        </div>
      </div>
    </div>
  </div>
</div>
