<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
  <div class="col-12 col-md-6 col-lg-4">
    <div class="card shadow-lg border-0">
      <div class="card-header text-center text-white" style="background-color: #1F509A;">
        <h4 class="mb-0">Nouveau mot de passe</h4>
      </div>
      <div class="card-body p-4">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= f.hidden_field :reset_password_token %>

          <% if resource.errors.any? %>
            <div class="alert alert-danger">
              <% resource.errors.full_messages.each do |message| %>
                <div><%= message %></div>
              <% end %>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :password, "Nouveau mot de passe", class: "form-label" %>
            <%= f.password_field :password, class: "form-control", placeholder: "Minimum 6 caractères", autofocus: true, autocomplete: "new-password" %>
            <div class="form-text">Minimum 6 caractères</div>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Répétez votre mot de passe", autocomplete: "new-password" %>
          </div>

          <div class="d-grid">
            <%= f.submit "Changer mon mot de passe", class: "btn btn-primary", style: "background-color: #1F509A; border-color: #1F509A;" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
