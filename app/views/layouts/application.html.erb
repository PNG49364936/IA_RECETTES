<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Recettes IA</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="UTF-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <!-- Header principal -->
    <header class="app-header">
      <div class="container d-flex justify-content-between align-items-center h-100">
        <a href="<%= root_path %>" class="text-decoration-none text-white fw-bold fs-5">
          Recettes IA
        </a>
        <div class="header-account">
          <% if user_signed_in? %>
            <%= link_to "Mon tableau de bord", dashboard_path, class: "text-white text-decoration-none me-3" %>
            <%= button_to "Déconnexion", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
          <% else %>
            <a href="#" class="text-white text-decoration-none" data-bs-toggle="modal" data-bs-target="#loginModal">
              Mon compte
            </a>
          <% end %>
        </div>
      </div>
    </header>

    <main class="container py-4">
      <% if flash[:alert].present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:alert] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
      <% end %>

      <% if flash[:notice].present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= flash[:notice] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer-custom py-3 mt-auto">
      <div class="container text-center">
        <small class="text-muted">Recettes IA - Version gratuite</small>
      </div>
    </footer>

    <!-- Modal de connexion -->
    <% unless user_signed_in? %>
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header" style="background-color: #1F509A;">
            <h5 class="modal-title text-white" id="loginModalLabel">Mon compte</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
          </div>
          <div class="modal-body">
            <!-- Onglets connexion / inscription -->
            <ul class="nav nav-tabs mb-3" id="authTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login-pane" type="button" role="tab">
                  Se connecter
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#register-pane" type="button" role="tab">
                  Créer mon compte
                </button>
              </li>
            </ul>

            <div class="tab-content" id="authTabsContent">
              <!-- Formulaire de connexion -->
              <div class="tab-pane fade show active" id="login-pane" role="tabpanel">
                <%= form_for(User.new, as: :user, url: user_session_path, html: { id: "login-form" }) do |f| %>
                  <div class="mb-3">
                    <%= f.label :email, "Adresse e-mail", class: "form-label" %>
                    <%= f.email_field :email, class: "form-control", placeholder: "exemple@email.com", required: true, autofocus: true %>
                  </div>
                  <div class="mb-3">
                    <%= f.label :password, "Mot de passe", class: "form-label" %>
                    <%= f.password_field :password, class: "form-control", placeholder: "Votre mot de passe", required: true %>
                  </div>
                  <div class="mb-3 form-check">
                    <%= f.check_box :remember_me, class: "form-check-input" %>
                    <%= f.label :remember_me, "Se souvenir de moi", class: "form-check-label" %>
                  </div>
                  <div class="d-grid">
                    <%= f.submit "Me connecter", class: "btn btn-primary", style: " border-color: #1F509A;" %>
                  </div>
                <% end %>
                <div class="text-center mt-3">
                  <%= link_to "Mot de passe oublié ?", new_user_password_path, class: "text-muted small" %>
                </div>
              </div>

              <!-- Formulaire d'inscription -->
              <div class="tab-pane fade" id="register-pane" role="tabpanel">
                <%= form_for(User.new, as: :user, url: user_registration_path, html: { id: "register-form" }) do |f| %>
                  <div class="mb-3">
                    <%= f.label :email, "Adresse e-mail", class: "form-label" %>
                    <%= f.email_field :email, class: "form-control", placeholder: "exemple@email.com", required: true %>
                  </div>
                  <div class="mb-3">
                    <%= f.label :password, "Mot de passe", class: "form-label" %>
                    <%= f.password_field :password, class: "form-control", placeholder: "Minimum 6 caractères", required: true %>
                    <div class="form-text">Minimum 6 caractères</div>
                  </div>
                  <div class="mb-3">
                    <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label" %>
                    <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Répétez votre mot de passe", required: true %>
                  </div>
                  <div class="d-grid">
                    <%= f.submit "Créer mon compte", class: "btn btn-primary", style: "background-color: #1F509A; border-color: #1F509A;" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>
  </body>
</html>
