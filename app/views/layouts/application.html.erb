<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t('layout.app_name') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="UTF-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <!-- Header principal -->
    <header class="app-header">
      <div class="container d-flex justify-content-between align-items-center h-100">
        <a href="<%= root_path %>" class="text-decoration-none text-white fw-bold fs-5">
          <%= t('layout.app_name') %>
        </a>
        <div class="header-account d-flex align-items-center">
          <!-- Sélecteur de langue -->
          <div class="me-3">
            <% if I18n.locale == :fr %>
              <%= link_to "ES", set_locale_path(:es), class: "text-white text-decoration-none small fw-bold", style: "opacity: 0.7;" %>
            <% else %>
              <%= link_to "FR", set_locale_path(:fr), class: "text-white text-decoration-none small fw-bold", style: "opacity: 0.7;" %>
            <% end %>
          </div>
          <% if user_signed_in? %>
            <%= link_to t('layout.my_dashboard'), dashboard_path, class: "text-white text-decoration-none me-3" %>
            <a href="#" class="text-white text-decoration-none me-3" data-bs-toggle="modal" data-bs-target="#accountModal">
              <%= t('layout.my_account') %>
            </a>
            <%= button_to t('layout.logout'), destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
          <% else %>
            <a href="#" class="text-white text-decoration-none" data-bs-toggle="modal" data-bs-target="#loginModal">
              <%= t('layout.my_account') %>
            </a>
          <% end %>
        </div>
      </div>
    </header>

    <main class="container py-4">
      <% if flash[:alert].present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:alert] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('layout.close') %>"></button>
        </div>
      <% end %>

      <% if flash[:notice].present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= flash[:notice] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('layout.close') %>"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer-custom py-3 mt-auto">
      <div class="container text-center">
        <small class="text-muted"><%= t('layout.footer') %></small>
      </div>
    </footer>

    <!-- Modal de connexion -->
    <% unless user_signed_in? %>
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header" style="background-color: #1F509A;">
            <h5 class="modal-title text-white" id="loginModalLabel"><%= t('layout.my_account') %></h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="<%= t('layout.close') %>"></button>
          </div>
          <div class="modal-body">
            <!-- Onglets connexion / inscription -->
            <ul class="nav nav-tabs mb-3" id="authTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login-pane" type="button" role="tab">
                  <%= t('layout.login_tab') %>
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#register-pane" type="button" role="tab" style="color: #000;">
                  <%= t('layout.register_tab') %>
                </button>
              </li>
            </ul>

            <div class="tab-content" id="authTabsContent">
              <!-- Formulaire de connexion -->
              <div class="tab-pane fade show active" id="login-pane" role="tabpanel">
                <%= form_for(User.new, as: :user, url: user_session_path, html: { id: "login-form" }) do |f| %>
                  <div class="mb-3">
                    <%= f.label :email, t('layout.email_label'), class: "form-label" %>
                    <%= f.email_field :email, class: "form-control", placeholder: t('layout.email_placeholder'), required: true, autofocus: true %>
                  </div>
                  <div class="mb-3">
                    <%= f.label :password, t('layout.password_label'), class: "form-label" %>
                    <%= f.password_field :password, class: "form-control", placeholder: t('layout.password_placeholder'), required: true %>
                  </div>
                  <div class="mb-3 form-check">
                    <%= f.check_box :remember_me, class: "form-check-input" %>
                    <%= f.label :remember_me, t('layout.remember_me'), class: "form-check-label" %>
                  </div>
                  <div class="d-grid">
                    <%= f.submit t('layout.login_submit'), class: "btn btn-primary", id: "login-submit-btn", style: " border-color: #1F509A;" %>
                  </div>

                  <!-- Spinner de chargement -->
                  <div id="login-spinner" class="text-center mt-3" style="display: none;">
                    <div class="spinner-border text-primary mb-2" role="status" style="width: 2.5rem; height: 2.5rem; color: #1F509A !important;">
                      <span class="visually-hidden"><%= t('layout.login_loading') %></span>
                    </div>
                    <div class="progress" style="height: 8px;">
                      <div id="login-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%; background-color: #1F509A;"></div>
                    </div>
                    <p class="text-muted small mt-2"><%= t('layout.login_loading') %></p>
                  </div>
                <% end %>
                <div class="text-center mt-3">
                  <%= link_to t('layout.forgot_password'), new_user_password_path, class: "text-muted small" %>
                </div>
              </div>

              <!-- Formulaire d'inscription -->
              <div class="tab-pane fade" id="register-pane" role="tabpanel">
                <%= form_for(User.new, as: :user, url: user_registration_path, html: { id: "register-form" }) do |f| %>
                  <div class="mb-3">
                    <%= f.label :email, t('layout.email_label'), class: "form-label" %>
                    <%= f.email_field :email, class: "form-control", placeholder: t('layout.email_placeholder'), required: true %>
                  </div>
                  <div class="mb-3">
                    <%= f.label :password, t('layout.password_label'), class: "form-label" %>
                    <%= f.password_field :password, class: "form-control", placeholder: t('layout.password_placeholder_register'), required: true %>
                    <div class="form-text"><%= t('layout.password_min_chars') %></div>
                  </div>
                  <div class="mb-3">
                    <%= f.label :password_confirmation, t('layout.confirm_password'), class: "form-label" %>
                    <%= f.password_field :password_confirmation, class: "form-control", placeholder: t('layout.confirm_password_placeholder'), required: true %>
                  </div>
                  <div class="d-grid">
                    <%= f.submit t('layout.register_submit'), class: "btn btn-primary", id: "register-submit-btn", style: "background-color: #1F509A; border-color: #1F509A; color: #fff;" %>
                  </div>

                  <!-- Spinner de chargement -->
                  <div id="register-spinner" class="text-center mt-3" style="display: none;">
                    <div class="spinner-border text-primary mb-2" role="status" style="width: 2.5rem; height: 2.5rem; color: #1F509A !important;">
                      <span class="visually-hidden"><%= t('layout.register_loading') %></span>
                    </div>
                    <div class="progress" style="height: 8px;">
                      <div id="register-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%; background-color: #1F509A;"></div>
                    </div>
                    <p class="text-muted small mt-2"><%= t('layout.register_loading') %></p>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>

    <!-- Modal Mon compte (utilisateur connecté) -->
    <% if user_signed_in? %>
    <div class="modal fade" id="accountModal" tabindex="-1" aria-labelledby="accountModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header" style="background-color: #1F509A;">
            <h5 class="modal-title text-white" id="accountModalLabel"><%= t('layout.my_account') %></h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="<%= t('layout.close') %>"></button>
          </div>
          <div class="modal-body">
            <!-- Onglets -->
            <ul class="nav nav-tabs mb-3" id="accountTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info-pane" type="button" role="tab">
                  <%= t('layout.my_info_tab') %>
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="delete-tab" data-bs-toggle="tab" data-bs-target="#delete-pane" type="button" role="tab" style="color: #D4574E;">
                  <%= t('layout.delete_account_tab') %>
                </button>
              </li>
            </ul>

            <div class="tab-content" id="accountTabsContent">
              <!-- Informations du compte -->
              <div class="tab-pane fade show active" id="info-pane" role="tabpanel">
                <div class="mb-3">
                  <label class="form-label fw-bold"><%= t('layout.email_label') %></label>
                  <p class="form-control-plaintext"><%= current_user.email %></p>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-bold"><%= t('layout.member_since') %></label>
                  <p class="form-control-plaintext"><%= l(current_user.created_at, format: :long) rescue current_user.created_at.strftime("%d/%m/%Y") %></p>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-bold"><%= t('layout.saved_recipes') %></label>
                  <p class="form-control-plaintext"><%= current_user.recipes.count %>/15</p>
                </div>
              </div>

              <!-- Suppression du compte -->
              <div class="tab-pane fade" id="delete-pane" role="tabpanel">
                <div class="alert alert-danger">
                  <h6 class="alert-heading fw-bold"><%= t('layout.delete_warning_title') %></h6>
                  <p class="mb-0"><%= t('layout.delete_warning_text') %></p>
                  <ul class="mt-2 mb-0">
                    <li><%= t('layout.delete_warning_recipes') %></li>
                    <li><%= t('layout.delete_warning_data') %></li>
                  </ul>
                </div>
                <%= button_to t('layout.delete_confirm_btn'),
                    user_registration_path,
                    method: :delete,
                    id: "delete-account-btn",
                    class: "btn btn-danger w-100",
                    data: { turbo_confirm: t('layout.delete_confirm_msg') } %>

                <!-- Spinner de suppression -->
                <div id="delete-spinner" class="text-center mt-3" style="display: none;">
                  <div class="spinner-border text-danger mb-2" role="status" style="width: 2.5rem; height: 2.5rem;">
                    <span class="visually-hidden"><%= t('layout.delete_loading') %></span>
                  </div>
                  <div class="progress" style="height: 8px;">
                    <div id="delete-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated bg-danger" role="progressbar" style="width: 0%;"></div>
                  </div>
                  <p class="text-muted small mt-2"><%= t('layout.delete_loading') %></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>

    <script>
      // Gestion du spinner de connexion
      document.addEventListener('DOMContentLoaded', function() {
        const loginForm = document.getElementById('login-form');
        const loginSpinner = document.getElementById('login-spinner');
        const loginBtn = document.getElementById('login-submit-btn');
        const loginProgressBar = document.getElementById('login-progress-bar');

        if (loginForm && loginSpinner && loginBtn) {
          loginForm.addEventListener('submit', function(e) {
            // Afficher le spinner et masquer le bouton
            loginBtn.style.display = 'none';
            loginSpinner.style.display = 'block';

            // Animation de la barre de progression
            let progress = 0;
            const interval = setInterval(function() {
              progress += Math.random() * 15;
              if (progress > 90) progress = 90;
              loginProgressBar.style.width = progress + '%';
            }, 200);

            // Nettoyer l'intervalle après 10 secondes
            setTimeout(function() {
              clearInterval(interval);
            }, 10000);
          });
        }

        // Même chose pour le formulaire d'inscription
        const registerForm = document.getElementById('register-form');
        const registerSpinner = document.getElementById('register-spinner');
        const registerBtn = document.getElementById('register-submit-btn');
        const registerProgressBar = document.getElementById('register-progress-bar');

        if (registerForm && registerSpinner && registerBtn) {
          registerForm.addEventListener('submit', function(e) {
            registerBtn.style.display = 'none';
            registerSpinner.style.display = 'block';

            let progress = 0;
            const interval = setInterval(function() {
              progress += Math.random() * 15;
              if (progress > 90) progress = 90;
              registerProgressBar.style.width = progress + '%';
            }, 200);

            setTimeout(function() {
              clearInterval(interval);
            }, 10000);
          });
        }

        // Gestion de la suppression du compte
        const deleteBtn = document.getElementById('delete-account-btn');
        const deleteSpinner = document.getElementById('delete-spinner');
        const deleteProgressBar = document.getElementById('delete-progress-bar');

        if (deleteBtn && deleteSpinner) {
          const deleteForm = deleteBtn.closest('form');
          if (deleteForm) {
            deleteForm.addEventListener('submit', function() {
              deleteBtn.style.display = 'none';
              deleteSpinner.style.display = 'block';

              let progress = 0;
              const interval = setInterval(function() {
                progress += Math.random() * 15;
                if (progress > 90) progress = 90;
                deleteProgressBar.style.width = progress + '%';
              }, 200);

              setTimeout(function() {
                clearInterval(interval);
              }, 10000);
            });
          }
        }
      });
    </script>
  </body>
</html>
