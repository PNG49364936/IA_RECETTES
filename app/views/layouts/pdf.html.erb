<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>Recettes IA - PDF</title>
    <style>
      body {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 14px;
        line-height: 1.6;
        color: #4A3728;
        margin: 0;
        padding: 20px;
      }

      .header {
        text-align: center;
        padding-bottom: 20px;
        border-bottom: 3px solid #E07B39;
        margin-bottom: 30px;
      }

      .header h1 {
        color: #E07B39;
        margin: 0;
        font-size: 28px;
      }

      .content h2 {
        color: #E07B39;
        font-size: 24px;
        margin-top: 0;
      }

      .content h3 {
        color: #C4A77D;
        font-size: 18px;
        border-bottom: 1px solid #C4A77D;
        padding-bottom: 5px;
        margin-top: 25px;
      }

      .content ul {
        padding-left: 20px;
      }

      .content li {
        margin-bottom: 8px;
      }

      .content ol {
        padding-left: 20px;
      }

      .content ol li {
        margin-bottom: 12px;
      }

      .content p {
        margin-bottom: 10px;
      }

      .content strong {
        color: #4A3728;
      }

      .footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #ddd;
        text-align: center;
        font-size: 12px;
        color: #888;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>Recettes IA</h1>
    </div>

    <div class="content">
      <%= yield %>
    </div>

    <div class="footer">
      Généré par Recettes IA - <%= Date.today.strftime('%d/%m/%Y') %>
    </div>
  </body>
</html>
