<div class="row justify-content-center">
  <div class="col-12 col-lg-10 col-xl-8">
    <div class="card shadow-sm recipe-card">
      <div class="card-header bg-primary-custom">
        <h2 class="card-title mb-0 text-white text-center">
          <%= t('recipes.your_recipe') %> (<%= translate_choice(@recipe.choice) %>)
        </h2>
      </div>
      <div class="card-body p-4">
        <div class="recipe-content">
          <%= @markdown_content %>
        </div>
      </div>
      <div class="card-footer bg-white">
        <div class="d-flex flex-wrap justify-content-center gap-2">
          <%= link_to t('recipes.new_recipe'), new_recipe_path, class: "btn btn-primary-custom" %>

          <!-- Bouton Imprimer visible uniquement sur PC -->
          <button type="button" class="btn btn-secondary d-none d-lg-inline-block" onclick="window.print()">
            <%= t('recipes.print') %>
          </button>

          <% if @is_new_recipe %>
            <!-- Recette non sauvegardée : bouton Sauvegarder -->
            <%= button_to t('recipes.save_recipe'), save_recipes_path(cache_key: @cache_key),
                method: :post,
                class: "btn btn-success" %>
          <% else %>
            <!-- Recette sauvegardée : boutons PDF et Supprimer -->
            <%= link_to download_pdf_recipe_path(@recipe), class: "btn btn-outline-secondary", data: { turbo: false } do %>
              <span class="d-none d-lg-inline"><%= t('recipes.download_pdf') %></span>
              <span class="d-lg-none"><%= t('recipes.download') %></span>
            <% end %>

            <%= button_to t('recipes.delete_recipe'), recipe_path(@recipe), method: :delete,
                class: "btn btn-outline-danger",
                data: { turbo_confirm: t('recipes.delete_confirm') } %>
          <% end %>
        </div>

        <div class="text-center mt-3">
          <%= link_to t('recipes.back_to_dashboard'), dashboard_path, class: "text-muted" %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Styles pour l'impression -->
<style>
  @media print {
    header, footer, .card-footer, .print-only {
      display: none !important;
    }
    .card {
      border: none !important;
      box-shadow: none !important;
    }
    .card-header {
      background-color: #E07B39 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
