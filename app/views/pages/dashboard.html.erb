<div class="dashboard-background">
  <div class="dashboard-overlay"></div>
  <div class="row justify-content-center position-relative">
    <div class="col-12 col-lg-10">
      <h1 class="mb-4" style="color: #1F509A;"><%= t('dashboard.title') %></h1>

    <div class="row g-4 mb-5">
      <!-- Créer une recette -->
      <div class="col-12 col-md-<%= current_user.admin? ? '4' : '6' %>">
        <div class="card h-100 shadow-sm border-0 dashboard-card">
          <div class="card-body text-center p-4">
            <div class="fs-1 mb-3">🍽️</div>
            <h5 class="card-title"><%= t('dashboard.create_recipe') %></h5>
            <p class="card-text text-muted"><%= t('dashboard.create_recipe_desc') %></p>
            <%= link_to t('dashboard.create_btn'), new_recipe_path, class: "btn btn-outline-primary", style: "border-color: #1F509A; color: #1F509A;" %>
          </div>
        </div>
      </div>

      <!-- Consulter mes recettes -->
      <div class="col-12 col-md-<%= current_user.admin? ? '4' : '6' %>">
        <div class="card h-100 shadow-sm border-0 dashboard-card">
          <div class="card-body text-center p-4">
            <div class="fs-1 mb-3">📚</div>
            <h5 class="card-title"><%= t('dashboard.my_recipes') %></h5>
            <p class="card-text text-muted"><%= t('dashboard.my_recipes_desc') %></p>
            <button type="button" class="btn btn-outline-primary" style="border-color: #1F509A; color: #1F509A;" data-bs-toggle="collapse" data-bs-target="#recipeCategories">
              <%= t('dashboard.view_by_category') %>
            </button>
          </div>
        </div>
      </div>

      <% if current_user.admin? %>
      <!-- Administration (admin uniquement) -->
      <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm border-0 dashboard-card" style="border-left: 4px solid #dc3545 !important;">
          <div class="card-body text-center p-4">
            <div class="fs-1 mb-3">⚙️</div>
            <h5 class="card-title"><%= t('dashboard.admin_title') %></h5>
            <p class="card-text text-muted"><%= t('dashboard.admin_desc') %></p>
            <%= link_to t('dashboard.admin_btn'), admin_path, class: "btn btn-danger" %>
          </div>
        </div>
      </div>
      <% end %>
    </div>

    <!-- Catégories de recettes (dépliable) -->
    <div class="collapse" id="recipeCategories">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
          <h5 class="card-title mb-4"><%= t('dashboard.recipes_by_category') %> <small class="text-muted">(<%= t('dashboard.max_recipes') %> - <%= current_user.recipes.count %>/15)</small></h5>

          <!-- Entrées -->
          <div class="category-section mb-4">
            <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center w-100"
                    type="button" data-bs-toggle="collapse" data-bs-target="#entreesList">
              <span class="category-icon me-2">🥗</span>
              <span class="fw-bold" style="color: #1F509A;"><%= t('dashboard.entrees') %></span>
              <span class="badge bg-secondary ms-2"><%= current_user.recipes.where(choice: 'Entrée').count %></span>
              <i class="bi bi-chevron-down ms-auto"></i>
            </button>
            <div class="collapse mt-2" id="entreesList">
              <% entrees = current_user.recipes.where(choice: 'Entrée').order(created_at: :desc) %>
              <% if entrees.any? %>
                <div class="list-group">
                  <% entrees.each do |recipe| %>
                    <%= link_to recipe_path(recipe), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
                      <span><%= recipe.extract_title_from_content %></span>
                      <i class="bi bi-chevron-right"></i>
                    <% end %>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted small ms-4"><%= t('dashboard.no_entree') %></p>
              <% end %>
            </div>
          </div>

          <!-- Plats principaux -->
          <div class="category-section mb-4">
            <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center w-100"
                    type="button" data-bs-toggle="collapse" data-bs-target="#platsList">
              <span class="category-icon me-2">🍝</span>
              <span class="fw-bold" style="color: #1F509A;"><%= t('dashboard.plats') %></span>
              <span class="badge bg-secondary ms-2"><%= current_user.recipes.where(choice: 'Plat principal').count %></span>
              <i class="bi bi-chevron-down ms-auto"></i>
            </button>
            <div class="collapse mt-2" id="platsList">
              <% plats = current_user.recipes.where(choice: 'Plat principal').order(created_at: :desc) %>
              <% if plats.any? %>
                <div class="list-group">
                  <% plats.each do |recipe| %>
                    <%= link_to recipe_path(recipe), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
                      <span><%= recipe.extract_title_from_content %></span>
                      <i class="bi bi-chevron-right"></i>
                    <% end %>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted small ms-4"><%= t('dashboard.no_plat') %></p>
              <% end %>
            </div>
          </div>

          <!-- Desserts -->
          <div class="category-section">
            <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center w-100"
                    type="button" data-bs-toggle="collapse" data-bs-target="#dessertsList">
              <span class="category-icon me-2">🍰</span>
              <span class="fw-bold" style="color: #1F509A;"><%= t('dashboard.desserts') %></span>
              <span class="badge bg-secondary ms-2"><%= current_user.recipes.where(choice: 'Dessert').count %></span>
              <i class="bi bi-chevron-down ms-auto"></i>
            </button>
            <div class="collapse mt-2" id="dessertsList">
              <% desserts = current_user.recipes.where(choice: 'Dessert').order(created_at: :desc) %>
              <% if desserts.any? %>
                <div class="list-group">
                  <% desserts.each do |recipe| %>
                    <%= link_to recipe_path(recipe), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
                      <span><%= recipe.extract_title_from_content %></span>
                      <i class="bi bi-chevron-right"></i>
                    <% end %>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted small ms-4"><%= t('dashboard.no_dessert') %></p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<style>
  .dashboard-background {
    position: relative;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    padding: 2rem 0;
  }

  @media (min-width: 992px) {
    .dashboard-background {
      background-image: url('<%= asset_path("WORLD CUISINE.jpg") %>');
    }
  }

  .dashboard-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.85);
    z-index: 1;
  }

  .dashboard-background > .row {
    z-index: 2;
  }

  .dashboard-card:hover {
    transform: translateY(-5px);
    transition: transform 0.2s ease;
  }
  .category-icon {
    font-size: 1.5rem;
  }
  .category-section .btn-link:hover {
    background-color: #f8f9fa;
    border-radius: 0.5rem;
  }
</style>
