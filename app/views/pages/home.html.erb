<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
  <div class="col-12 col-md-8 col-lg-6 text-center">
    <div class="card shadow-lg border-0">
      <div class="card-body p-5">
        <h1 class="display-5 fw-bold mb-4" style="color: #1F509A;"><%= t('home.title') %></h1>
        <p class="lead text-muted mb-4">
          <%= t('home.subtitle') %>
        </p>
        <div class="d-grid gap-2 d-md-flex justify-content-center">
          <button type="button" class="btn btn-lg px-4" style="background-color: #1F509A; color: white;" data-bs-toggle="modal" data-bs-target="#loginModal">
            <%= t('home.start_btn') %>
          </button>
        </div>
        <hr class="my-4">
        <div class="row text-center">
          <div class="col-4">
            <div class="fs-1 mb-2">🍳</div>
            <small class="text-muted"><%= t('home.cuisines') %></small>
          </div>
          <div class="col-4">
            <div class="fs-1 mb-2">📱</div>
            <small class="text-muted"><%= t('home.export_pdf') %></small>
          </div>
          <div class="col-4">
            <div class="fs-1 mb-2">💾</div>
            <small class="text-muted"><%= t('home.save') %></small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
