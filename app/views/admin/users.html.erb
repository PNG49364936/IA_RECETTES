<div class="row justify-content-center">
  <div class="col-12 col-lg-10">
    <h1 class="mb-4" style="color: #1F509A;">Utilisateurs (<%= @users.count %>)</h1>

    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Email</th>
                <th>Mot de passe</th>
                <th>Recettes</th>
                <th>Inscrit le</th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |user| %>
                <tr>
                  <td>
                    <%= user.email %>
                    <% if user.admin? %>
                      <span class="badge bg-primary ms-2">Admin</span>
                    <% end %>
                  </td>
                  <td><code>********</code> <small class="text-muted">(crypté)</small></td>
                  <td><%= user.recipes.count %></td>
                  <td><%= l(user.created_at, format: :short) rescue user.created_at.strftime("%d/%m/%Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="text-center mt-4">
      <%= link_to "← Retour à l'administration", admin_path, class: "text-muted" %>
    </div>
  </div>
</div>
